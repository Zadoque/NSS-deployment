# NSS 1.0 - modelo de ambiente. NÃO coloque valores reais neste arquivo.
# Em servidor, copie para /etc/nss/deployment.env, chmod 600 e use o script.
# O caminho pode ser alterado com NSS_ENV_FILE.

# Imagens construídas/tagueadas a partir dos repositórios independentes
NSS_FRONTEND_IMAGE=nss-frontend:local
NSS_JAVA_IMAGE=nss-java:local
# Produção usa digest; para build local explícito, defina local-build e tags.
NSS_IMAGE_MODE=digest
NSS_PIPELINE_IMAGE_MODE=digest
NSS_PIPELINE_IMAGE=registry.local/nss-pipeline@sha256:CHANGE_ME
NSS_DATABASE_IMAGE=nss-database:0001
NSS_GRAFANA_IMAGE=grafana/grafana:latest
REDIS_IMAGE=redis:7-alpine

# Porta local do Caddy. O ngrok HTTPS aponta para 127.0.0.1:NSS_HTTP_PORT.
NSS_HTTP_PORT=8080

# PostgreSQL compartilhado
POSTGRES_DB=situacao_saude
POSTGRES_APP_DB=nss
POSTGRES_ADMIN_USER=nss_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Usuários separados por responsabilidade
NSS_APP_RUNTIME_USER=nss_app_runtime
NSS_APP_RUNTIME_PASSWORD=CHANGE_ME
NSS_APP_MIGRATOR_USER=nss_app_migrator
NSS_APP_MIGRATOR_PASSWORD=CHANGE_ME
NSS_ANALYTICS_READER_USER=nss_analytics_reader
NSS_ANALYTICS_READER_PASSWORD=CHANGE_ME
NSS_ANALYTICS_WRITER_USER=nss_analytics_writer
NSS_ANALYTICS_WRITER_PASSWORD=CHANGE_ME
NSS_ANALYTICS_MIGRATOR_USER=nss_analytics_migrator
NSS_ANALYTICS_MIGRATOR_PASSWORD=CHANGE_ME

# Spring / JWT
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRATION=900000
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
CORS_ALLOWED_ORIGINS=
SECURE_COOKIES=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Grafana bootstrap (trocar antes de uso real)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
NSS_GRAFANA_DB_USER=grafana_ro
NSS_GRAFANA_DB_PASSWORD=CHANGE_ME

# Ngrok não deve ser passado ao Compose; fica no secret store/configuração NixOS.
# NGROK_AUTHTOKEN=<NÃO VERSIONAR>
