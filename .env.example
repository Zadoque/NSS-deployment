# Somente front estático + Caddy. Não copie credenciais da stack completa.
# Para servidor, prefira referências de imagens imutáveis (@sha256:...).
NSS_FRONTEND_IMAGE=nss-frontend:prod-mock
NSS_FRONTEND_CONTEXT=../NSS-front-end
NSS_CADDY_IMAGE=caddy:2-alpine
# Loopback para ngrok. Pela GINFO, use o IP/interface autorizado do servidor.
NSS_BIND_ADDRESS=127.0.0.1
NSS_HTTP_PORT=8080
NSS_FRONTEND_CPUS=0.50
NSS_FRONTEND_MEMORY_LIMIT=128m
NSS_CADDY_CPUS=0.50
NSS_CADDY_MEMORY_LIMIT=128m
