# NSS 1.0 - exemplo de ambiente. NÃO coloque valores reais neste arquivo.

# Imagens construídas/tagueadas a partir dos repositórios independentes
# Use immutable digests or release tags produced by the CI/release manifest.
NSS_POSTGRES_IMAGE=postgres:16.15-alpine
NSS_CADDY_IMAGE=caddy:2.10.2-alpine
NSS_FRONTEND_IMAGE=nss-frontend:RELEASE_SHA
NSS_JAVA_IMAGE=nss-java:RELEASE_SHA
NSS_PIPELINE_IMAGE=nss-pipeline:RELEASE_SHA
NSS_GRAFANA_IMAGE=grafana/grafana:RELEASE_SHA
NSS_PROMETHEUS_IMAGE=prom/prometheus:RELEASE_SHA
NSS_PUSHGATEWAY_IMAGE=prom/pushgateway:RELEASE_SHA
NSS_NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:RELEASE_SHA

# Porta local do Caddy. O ngrok HTTPS aponta para 127.0.0.1:NSS_HTTP_PORT.
NSS_HTTP_PORT=8080

# Resource ceilings for the 128 GiB NSS server. They are enforced by Docker
# cgroups, including services started by systemd timers. These are ceilings,
# not reserved allocations: keep substantial RAM available to NixOS, SSH,
# Docker and filesystem cache, then revise them after observing production.
NSS_DB_CPUS=1.50
NSS_DB_MEMORY_LIMIT=12g
NSS_DB_MEMORY_RESERVATION=4g
NSS_DB_PIDS_LIMIT=256
NSS_DB_NOFILE_SOFT=32768
NSS_DB_NOFILE_HARD=65536
NSS_DB_PROVISION_CPUS=0.50
NSS_DB_PROVISION_MEMORY_LIMIT=512m
NSS_DB_PROVISION_MEMORY_RESERVATION=256m
NSS_DB_PROVISION_PIDS_LIMIT=64
NSS_JAVA_CPUS=1.50
NSS_JAVA_MEMORY_LIMIT=4g
NSS_JAVA_MEMORY_RESERVATION=1g
NSS_JAVA_PIDS_LIMIT=256
NSS_JAVA_NOFILE_SOFT=32768
NSS_JAVA_NOFILE_HARD=65536
NSS_JAVA_MAX_RAM_PERCENTAGE=65.0
NSS_FRONTEND_CPUS=0.25
NSS_FRONTEND_MEMORY_LIMIT=128m
NSS_FRONTEND_MEMORY_RESERVATION=64m
NSS_FRONTEND_PIDS_LIMIT=64
NSS_FRONTEND_NOFILE_SOFT=4096
NSS_FRONTEND_NOFILE_HARD=8192
NSS_CADDY_CPUS=0.50
NSS_CADDY_MEMORY_LIMIT=256m
NSS_CADDY_MEMORY_RESERVATION=64m
NSS_CADDY_PIDS_LIMIT=128
NSS_CADDY_NOFILE_SOFT=16384
NSS_CADDY_NOFILE_HARD=32768
NSS_GRAFANA_CPUS=0.50
NSS_GRAFANA_MEMORY_LIMIT=1g
NSS_GRAFANA_MEMORY_RESERVATION=512m
NSS_GRAFANA_PIDS_LIMIT=256
NSS_PROMETHEUS_CPUS=0.75
NSS_PROMETHEUS_MEMORY_LIMIT=4g
NSS_PROMETHEUS_MEMORY_RESERVATION=1g
NSS_PROMETHEUS_PIDS_LIMIT=256
NSS_PUSHGATEWAY_CPUS=0.25
NSS_PUSHGATEWAY_MEMORY_LIMIT=256m
NSS_PUSHGATEWAY_MEMORY_RESERVATION=64m
NSS_PUSHGATEWAY_PIDS_LIMIT=64
NSS_NODE_EXPORTER_CPUS=0.25
NSS_NODE_EXPORTER_MEMORY_LIMIT=256m
NSS_NODE_EXPORTER_MEMORY_RESERVATION=64m
NSS_NODE_EXPORTER_PIDS_LIMIT=64
# The pipeline runs as a scheduled one-off job. Its higher ceiling does not
# reserve 16 GiB permanently, but it must still fit alongside the live stack.
NSS_PIPELINE_CPUS=2.00
NSS_PIPELINE_MEMORY_LIMIT=16g
NSS_PIPELINE_MEMORY_RESERVATION=2g
NSS_PIPELINE_PIDS_LIMIT=256
NSS_PIPELINE_NOFILE_SOFT=16384
NSS_PIPELINE_NOFILE_HARD=32768
NSS_PIPELINE_MIGRATE_CPUS=1.00
NSS_PIPELINE_MIGRATE_MEMORY_LIMIT=1g
NSS_PIPELINE_MIGRATE_MEMORY_RESERVATION=256m
NSS_PIPELINE_MIGRATE_PIDS_LIMIT=128

# PostgreSQL compartilhado: banco analítico da pipeline
POSTGRES_DB=situacao_saude
# Banco operacional do Java (criado no primeiro volume novo)
POSTGRES_APP_DB=nss
POSTGRES_ADMIN_USER=nss_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
NSS_APP_MIGRATOR_USER=nss_app_migrator
NSS_APP_MIGRATOR_PASSWORD=CHANGE_ME
NSS_APP_RUNTIME_USER=nss_app_runtime
NSS_APP_RUNTIME_PASSWORD=CHANGE_ME
NSS_ANALYTICS_WRITER_USER=nss_analytics_writer
NSS_ANALYTICS_WRITER_PASSWORD=CHANGE_ME
NSS_ANALYTICS_READER_USER=nss_analytics_reader
NSS_ANALYTICS_READER_PASSWORD=CHANGE_ME
NSS_BACKUP_USER=nss_backup
NSS_BACKUP_PASSWORD=CHANGE_ME

# Spring / JWT
# Gere com: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_BASE64_64_BYTES
JWT_EXPIRATION=900000
REFRESH_EXPIRATION=604800000
SECURE_COOKIES=true
CORS_ALLOWED_ORIGINS=
FIRST_ACCESS_FRONTEND_URL=http://localhost:8080
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP; nunca versionar valores reais
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Grafana bootstrap (trocar antes de uso real)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Ative com `docker compose --profile monitoring up -d`. Esta URL só é usada
# pela pipeline quando o Pushgateway está no mesmo projeto Compose.
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091

# Ngrok não deve ser passado ao Compose; fica no secret store/configuração NixOS.
# NGROK_AUTHTOKEN=<NÃO VERSIONAR>
