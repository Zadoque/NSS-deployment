digraph NSS {
  graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.7, pad=0.18, fontname="DejaVu Sans", label="NSS v1.5 — fronteiras de domínio e fontes de verdade", labelloc=t, fontsize=16];
  node [shape=box, style="rounded,filled", fillcolor="#F3F6F8", color="#174A7E", penwidth=1.3, fontname="DejaVu Sans", fontsize=10];
  edge [color="#607585", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  User [label="Usuário / Visitante"];
  Proxy [label="Caddy HTTPS\nmesma origem"];
  React [label="React SPA\nUX e IndexedDB"];
  Java [label="Java Spring\nmonólito modular", fillcolor="#E4F0FB"];
  PG [label="PostgreSQL 16\nschemas operacionais", shape=cylinder];
  Gold [label="analytics + analytics_animal\nGold publicada", shape=cylinder, fillcolor="#E8F6ED"];
  Pipeline [label="Pipeline Python\nBronze → Silver → Gold", fillcolor="#E8F6ED"];
  Ext [label="SINAN · CNES · IBGE"];
  Redis [label="4 Redis isolados\nsessão / taxa / analítico / público"];
  Storage [label="Armazenamento institucional\nobjetos + manifesto SHA-256"];
  SMTP [label="SMTP via outbox\ndurável"];
  User -> Proxy; Proxy -> React; React -> Proxy [label="API", constraint=false]; Proxy -> Java; Java -> PG; Java -> Gold [label="somente leitura"]; Java -> Redis; Java -> Storage; Java -> SMTP; Ext -> Pipeline; Pipeline -> Gold [label="publicação atômica"]; PG -> Pipeline [label="visão clínica mínima", style=dashed];
}
