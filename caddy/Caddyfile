{
    admin off
    auto_https off
}

:80 {
    encode zstd gzip
    header -Server

    # Somente páginas públicas e arquivos necessários ao build estático.
    # GET/HEAD apenas: nenhuma credencial ou escrita é encaminhada ao front.
    @frontend {
        method GET HEAD
        path_regexp frontend ^/(|mapa/?|login/?|healthz|favicon\.ico|assets/[A-Za-z0-9_-]+\.(js|css|woff2?|svg|png)|maps/(brazil-regions|southeast-states|rj-municipalities|campos-districts|campos-neighborhoods)\.geojson|snapshot/(manifest|(chik|deng|fmac|toxc|toxg|zika)-[a-f0-9]{12})\.json)$
    }
    handle @frontend {
        reverse_proxy frontend:80
    }
    handle {
        respond "Not found" 404
    }
}
