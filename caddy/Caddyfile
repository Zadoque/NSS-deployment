:80 {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
    }

    handle /api/* {
        reverse_proxy java:8080
    }

    handle {
        reverse_proxy frontend:80
    }
}
